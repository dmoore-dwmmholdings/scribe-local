# Copy to .env and adjust. Used by docker-compose.yml and (optionally) sourced
# before running `scribe` so secrets stay out of the committed TOML files.
# Scribe reads SCRIBE_<SECTION>__<KEY> overrides at startup.

# --- docker compose ---
# Host port for the pgvector Postgres container. Default 5432; this repo's docs
# use 5433 because a native Postgres often already holds 5432.
POSTGRES_PORT=5433

# --- scribe config overrides (examples; uncomment as needed) ---
# SCRIBE_DATABASE__URL=postgres://scribe:scribe@localhost:5433/scribe?sslmode=disable
# SCRIBE_STORAGE__SIGNING_SECRET=change-me-openssl-rand-hex-32
# SCRIBE_AUTH__REQUIRE_DEVICE_TOKEN=true

# --- self-update (only if you enable [update]) ---
# SCRIBE_UPDATE__TOKEN=change-me-openssl-rand-hex-32
# SCRIBE_UPDATE__PUBLIC_KEY=<64-hex from `scribe update keygen`>
