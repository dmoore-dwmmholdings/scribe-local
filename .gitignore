# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Scribe runtime data
/var
/data
*.wav
*.m4a
*.onnx
/blobs
# Downloaded model assets, but keep the docs that explain them.
/models/*
!/models/README.md
# fastembed downloads its ONNX embedding model here at runtime.
.fastembed_cache/
# Local tool binaries (a pinned ffmpeg the launch scripts put on PATH).
/tools

# Env / secrets
.env
*.local.toml
devices.toml
# Update signing keys and built update packages — never commit these.
*.key
release.key*
scribe-*.tar.gz
# Packaged server bundle produced by scripts/package-release.ps1.
/dist

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json

# Reference transcripts of real meetings, used to score the pipeline. This repo
# is public: they and the audio stay out of it.
*_otter.ai.txt

# Native iOS app: the Xcode project is generated by XcodeGen from ios/project.yml.
/ios/Scribe.xcodeproj/
/ios/build/
