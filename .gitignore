# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Scribe runtime data
/var
/data
*.wav
*.m4a
*.onnx
/blobs
# Downloaded model assets, but keep the docs that explain them.
/models/*
!/models/README.md
# fastembed downloads its ONNX embedding model here at runtime.
.fastembed_cache/
# Local tool binaries (a pinned ffmpeg the launch scripts put on PATH).
/tools

# Env / secrets
.env
*.local.toml
devices.toml
# Update signing keys and built update packages — never commit these.
*.key
release.key*
scribe-*.tar.gz
# Packaged server bundle produced by scripts/package-release.ps1.
/dist

# Node / Expo (mobile)
mobile/node_modules
mobile/.expo
mobile/dist
mobile/web-build
mobile/*.log
mobile/.expo-shared

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
